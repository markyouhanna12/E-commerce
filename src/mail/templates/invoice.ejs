<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Your Invoice</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f6f8; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #111827;
                  padding: 30px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: bold;
                  "
                >
                  Betak ElTani
                </h1>

                <p style="margin: 8px 0 0; color: #d1d5db; font-size: 14px">
                  Thank you for your purchase
                </p>
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style="padding: 35px 35px 10px">
                <p
                  style="
                    margin: 0;
                    font-size: 18px;
                    color: #111827;
                    font-weight: bold;
                  "
                >
                  Hello <%= locals.customerName %>,
                </p>

                <p
                  style="
                    margin: 15px 0 0;
                    color: #4b5563;
                    font-size: 15px;
                    line-height: 1.6;
                  "
                >
                  Thank you for shopping with us. Your payment has been
                  successfully completed and your invoice is attached to this
                  email.
                </p>
              </td>
            </tr>

            <!-- Invoice Summary -->
            <tr>
              <td style="padding: 25px 35px">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f9fafb;
                    border: 1px solid #e5e7eb;
                    border-radius: 8px;
                  "
                >
                  <tr>
                    <td style="padding: 20px; color: #6b7280; font-size: 13px">
                      Invoice Number
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 20px;
                        color: #111827;
                        font-size: 14px;
                        font-weight: bold;
                      "
                    >
                      <%= locals.invoiceNumber %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        padding: 0 20px 20px;
                        color: #6b7280;
                        font-size: 13px;
                      "
                    >
                      Amount Paid
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 0 20px 20px;
                        color: #111827;
                        font-size: 18px;
                        font-weight: bold;
                      "
                    >
                      <%= locals.currency %> <%= locals.total %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        padding: 0 20px 20px;
                        color: #6b7280;
                        font-size: 13px;
                      "
                    >
                      Payment Status
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 0 20px 20px;
                        color: #15803d;
                        font-size: 14px;
                        font-weight: bold;
                      "
                    >
                      PAID
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Attachment Notice -->
            <tr>
              <td style="padding: 5px 35px 25px">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #eff6ff;
                    border-left: 4px solid #2563eb;
                  "
                >
                  <tr>
                    <td
                      style="
                        padding: 18px;
                        color: #1e3a8a;
                        font-size: 14px;
                        line-height: 1.6;
                      "
                    >
                      Your official invoice is attached to this email as a PDF
                      file. Please keep it for your records.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Closing -->
            <tr>
              <td style="padding: 10px 35px 35px; text-align: center">
                <p
                  style="
                    margin: 0;
                    color: #4b5563;
                    font-size: 14px;
                    line-height: 1.6;
                  "
                >
                  We appreciate your business and hope to see you again.
                </p>

                <p
                  style="
                    margin: 18px 0 0;
                    color: #111827;
                    font-size: 14px;
                    font-weight: bold;
                  "
                >
                  Betak ElTani
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f9fafb;
                  padding: 20px;
                  text-align: center;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p style="margin: 0; color: #9ca3af; font-size: 12px">
                  This is an automated email. Please do not reply directly to
                  this message.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
